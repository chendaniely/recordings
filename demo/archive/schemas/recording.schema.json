{
  "$defs": {
    "Chosen": {
      "additionalProperties": false,
      "properties": {
        "transcript": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript"
        }
      },
      "title": "Chosen",
      "type": "object"
    },
    "MediaInfo": {
      "additionalProperties": false,
      "properties": {
        "audio_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio File"
        },
        "channels": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "kind": {
          "enum": [
            "audio",
            "video"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sample_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "file",
        "sha256",
        "kind"
      ],
      "title": "MediaInfo",
      "type": "object"
    },
    "PlaudState": {
      "additionalProperties": false,
      "description": "What Plaud last said, as far as Dan has seen it (§6.3, §6.8).",
      "properties": {
        "acknowledged_up_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acknowledged Up To"
        },
        "title_seen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title Seen"
        }
      },
      "title": "PlaudState",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "added_at": {
          "format": "date-time",
          "title": "Added At",
          "type": "string"
        },
        "fetched_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fetched At"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "ref",
        "added_at"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SpeakerLabel": {
      "additionalProperties": false,
      "description": "Your decision about one diarization label (§7.6). Inferences never live in the file.",
      "properties": {
        "by": {
          "anyOf": [
            {
              "const": "you",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        },
        "not": {
          "items": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Not",
          "type": "array"
        },
        "person": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Person"
        },
        "plaud_name_seen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plaud Name Seen"
        }
      },
      "title": "SpeakerLabel",
      "type": "object"
    },
    "SpeakerSpan": {
      "additionalProperties": false,
      "description": "A stretch of media time, in seconds, that is someone else, or `unknown` (§7.6).",
      "properties": {
        "by": {
          "const": "you",
          "default": "you",
          "title": "By",
          "type": "string"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "person": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Person",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end",
        "person"
      ],
      "title": "SpeakerSpan",
      "type": "object"
    },
    "Speakers": {
      "additionalProperties": false,
      "description": "Speaker decisions (§7.6). `source` names the diarization the labels belong to.",
      "properties": {
        "labels": {
          "additionalProperties": {
            "$ref": "#/$defs/SpeakerLabel"
          },
          "title": "Labels",
          "type": "object"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/SpeakerSpan"
          },
          "title": "Spans",
          "type": "array"
        }
      },
      "title": "Speakers",
      "type": "object"
    },
    "TagRef": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "default": "you",
          "enum": [
            "you",
            "auto"
          ],
          "title": "By",
          "type": "string"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        }
      },
      "required": [
        "tag"
      ],
      "title": "TagRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "chosen": {
      "$ref": "#/$defs/Chosen"
    },
    "excluded_note_types": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Note Types",
      "type": "array"
    },
    "format": {
      "const": "recordings-archive@1",
      "default": "recordings-archive@1",
      "title": "Format",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9]{8}T[0-9]{6}[+-][0-9]{4}_[0-9a-f]{8}$",
      "title": "Id",
      "type": "string"
    },
    "media": {
      "$ref": "#/$defs/MediaInfo"
    },
    "plaud": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaudState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "rev": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rev"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Sources",
      "type": "array"
    },
    "speakers": {
      "$ref": "#/$defs/Speakers"
    },
    "tags": {
      "items": {
        "$ref": "#/$defs/TagRef"
      },
      "title": "Tags",
      "type": "array"
    },
    "time_source": {
      "enum": [
        "plaud",
        "metadata",
        "published",
        "mtime",
        "ingest"
      ],
      "title": "Time Source",
      "type": "string"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "title_by": {
      "anyOf": [
        {
          "enum": [
            "you",
            "plaud",
            "recorder",
            "pocket"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title By"
    }
  },
  "required": [
    "id",
    "title",
    "recorded_at",
    "timezone",
    "time_source",
    "media"
  ],
  "title": "Recording",
  "type": "object"
}
